# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PowerSync
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
VITE_ENABLE_POWERSYNC=false

# Feature Flags
# VITE_ENABLE_ECOMMERCE=false
#
# AI features (requires ai-task-summary Edge Function deployed in Supabase)
# When true: shows "Resumen IA" button in TasksPage
VITE_ENABLE_AI=false

# Entity / Workspace configuration
# Label that appears in UI for the main business entity (singular).
# Change this per deployment: "Proyecto", "Obra", "Cliente", "Caso", "Campaña"…
VITE_ENTITY_LABEL=Proyecto

# Optional: explicit plural form. If omitted, auto-derived (vowel→+s, consonant→+es).
# E.g. VITE_ENTITY_LABEL=Proyecto → auto "Proyectos" ✓
#      VITE_ENTITY_LABEL=Entidad  → auto "Entidades" ✓
# VITE_ENTITY_LABEL_PLURAL=Proyectos

# Set to "false" to hide the EntitySelector (single-entity deployments)
VITE_ENABLE_MULTI_ENTITY=true

# ───────────────────────────────────────────────────────────────────────────────
# Desarrollo local — ERP + Astro (ver docs/SETUP.md §8.0 y `pnpm dev:all`)
# ───────────────────────────────────────────────────────────────────────────────
# Dos apps en el mismo repo = dos puertos en tu máquina:
#   • ERP (Vite)     → http://localhost:7070  — login, dashboard, catálogo admin
#   • Público Astro  → http://localhost:4321 — landing SEO, /productos
#
# En producción sustituye por dominios reales (ej. www + app.tucliente.com).

VITE_PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:7070

# Opcional — mismo .env es leído por astro/ (sin duplicar Supabase)
# PUBLIC_ENABLE_ECOMMERCE=true
# PUBLIC_BRAND_NAME=Mi Empresa
