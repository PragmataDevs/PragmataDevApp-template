# ═══ Supabase ═══════════════════════════════════════════════════════════════
# Activo = local Docker (`supabase start`). API :54321 por defecto (no :54323 = Studio).
# Varias copias en un PC → otros puertos: docs/supabase-local-copias-y-studio.md
# Clave Publishable: `supabase status` en la raíz del repo (columna Publishable).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_KEY_FROM_supabase_status
#
# ─── Copiar a Vercel (Production) — proyecto nube, NO descomentar aquí si sigues en local ───
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon_public_del_Dashboard>
#
# Si reinicias local y falla la clave: `supabase status` → vuelve a pegar Publishable arriba.

# PowerSync
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
VITE_ENABLE_POWERSYNC=false

# Feature Flags
# Ecommerce ERP (sidebar + /ecommerce/*): true | false
VITE_ENABLE_ECOMMERCE=false
#
# CMS del sitio público — grupo SEO en sidebar (`/seo/pages`). Por defecto activo; pon false para ocultarlo.
# VITE_ENABLE_SITE_CMS=false
#
# AI features (requires ai-task-summary Edge Function deployed in Supabase)
# When true: shows "Resumen IA" button in TasksPage
VITE_ENABLE_AI=false

# Entity / Workspace configuration
# Label that appears in UI for the main business entity (singular).
# Change this per deployment: "Proyecto", "Obra", "Cliente", "Caso", "Campaña"…
VITE_ENTITY_LABEL=Proyecto

# Optional: explicit plural form. If omitted, auto-derived (vowel→+s, consonant→+es).
# E.g. VITE_ENTITY_LABEL=Proyecto → auto "Proyectos" ✓
#      VITE_ENTITY_LABEL=Entidad  → auto "Entidades" ✓
# VITE_ENTITY_LABEL_PLURAL=Proyectos

# Set to "false" to hide the EntitySelector (single-entity deployments)
VITE_ENABLE_MULTI_ENTITY=true

# ───────────────────────────────────────────────────────────────────────────────
# Desarrollo local — ERP + Astro (`pnpm dev:all`). Matriz prod/staging/Vercel: docs/deployment-environments.md
# ───────────────────────────────────────────────────────────────────────────────
# Local: ERP :7070 · Astro :4321
#
# ─── Copiar a Vercel (Production) — ajusta dominios a los tuyos ───
# Proyecto ERP (Vite): VITE_PUBLIC_SITE_URL = URL pública del sitio (Astro)
# Proyecto Web (Astro build): PUBLIC_SITE_URL y PUBLIC_APP_URL obligatorios en prod
# VITE_PUBLIC_SITE_URL=https://www.tudominio.com
# PUBLIC_SITE_URL=https://www.tudominio.com
# PUBLIC_APP_URL=https://app.tudominio.com
#
# Desarrollo: localhost en PUBLIC_* sirve en la máquina del server; si abres el sitio
# desde el celular por IP (100.x, 192.168.x), los enlaces «Iniciar sesión» usan esa IP
# con :7070 automáticamente (ver astro/src/lib/public-urls.ts). ERP y Astro con host:true.

VITE_PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:7070

# Opcional — mismo .env es leído por astro/ (sin duplicar Supabase)
# Catálogo/carrito en sitio público Astro: true | false
PUBLIC_ENABLE_ECOMMERCE=false
# PUBLIC_BRAND_NAME=Mi Empresa
