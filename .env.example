# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PowerSync
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
VITE_ENABLE_POWERSYNC=false

# Feature Flags
# VITE_ENABLE_ECOMMERCE=false
# VITE_ENABLE_AI=false

# Entity / Workspace configuration
# Label that appears in UI for the main business entity (singular).
# Change this per deployment: "Proyecto", "Obra", "Cliente", "Caso", "Campaña"…
VITE_ENTITY_LABEL=Proyecto

# Optional: explicit plural form. If omitted, auto-derived (vowel→+s, consonant→+es).
# E.g. VITE_ENTITY_LABEL=Proyecto → auto "Proyectos" ✓
#      VITE_ENTITY_LABEL=Entidad  → auto "Entidades" ✓
# VITE_ENTITY_LABEL_PLURAL=Proyectos

# Set to "false" to hide the EntitySelector (single-entity deployments)
VITE_ENABLE_MULTI_ENTITY=true
