# ═══ Puertos de desarrollo ══════════════════════════════════════════════════
# NO se eligen a mano. Los manda el registro central: ~/PragmataDevs/ports.json
#
# Cada proyecto tiene un índice `n` y de ahí se derivan TODOS sus puertos:
#   app (Vite) = 7000 + n*10      astro = 7000 + n*10 + 1
#   supabase api = 54300 + n*10 + 1   (db +1 · studio +2 · inbucket +3)
# La década 70n0..70n9 completa queda reservada al proyecto.
#
# Al instanciar un cliente, `allocate-dev-ports.mjs` le reserva su `n` en el registro
# y `compose-client-env.mjs` escribe estas dos llaves acá. Si faltan, el vite.config
# cae al puerto del PROPIO template y `strictPort` lo hace tronar de inmediato — a
# propósito: antes el default era un 7070 compartido y tres proyectos se lo peleaban.
#
# Ver el mapa:   cd ~/PragmataDevs && pnpm ports:check --table
# Validar:       pnpm ports:check      (revienta si algún puerto se salió del registro)
# VITE_PORT=7020
# ASTRO_PORT=7021

# ═══ Supabase ═══════════════════════════════════════════════════════════════
# Activo = local Docker (`supabase start`). API :54321 por defecto (no :54323 = Studio).
# Varias copias en un PC → otros puertos: docs/supabase-local-copias-y-studio.md
# Clave Publishable: `supabase status` en la raíz del repo (columna Publishable).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_KEY_FROM_supabase_status
#
# ─── Dev multi-equipo (cel / iPad / otra Mac vía Tailscale) ───
# 127.0.0.1 SOLO funciona parado en el server. Para abrir el ERP desde otro equipo
# de la tailnet, apunta esta URL a la IP de tailscale del server + el puerto Kong:
#   VITE_SUPABASE_URL=http://100.x.y.z:54321      (la IP de tailscale del server)
# Sigue sirviendo desde el server (alcanza su propia IP de tailscale), así que es
# un solo valor para todos los equipos. Requisitos:
#   1) Supabase escuchando en 0.0.0.0 (default de `supabase start`, NO red loopback).
#   2) Los puertos Kong/Studio/Inbucket del cliente en TAILNET_ALLOW de
#      pragmata-hub/pragmata-firewall.sh — NUNCA el de Postgres (la DB cruda no sale
#      del loopback/tailnet, la bloquea el firewall).
#   3) El dev server Vite/Astro ya escucha en todas las interfaces (host:true).
# Cierre de seguridad por cliente: rotar las llaves demo (anon/service_role).
#
# Puerto de la API de Supabase (se inyecta automáticamente en merge-supabase-env.mjs).
# Si el factory form solicita un puerto base distinto, se refleja aquí.
# VITE_SUPABASE_API_PORT=54321
# PUBLIC_SUPABASE_API_PORT=54321
#
# También se escriben automáticamente como PUBLIC_* para compatibilidad con Astro:
# PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLIC_SUPABASE_ANON_KEY=<anon_key>
#
# ─── Copiar a Vercel (Production) — proyecto nube, NO descomentar aquí si sigues en local ───
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon_public_del_Dashboard>
#
# Si reinicias local y falla la clave: `supabase status` → vuelve a pegar Publishable arriba.

# PowerSync
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
VITE_ENABLE_POWERSYNC=false

# Feature Flags
# Ecommerce ERP (sidebar + /ecommerce/*): true | false
VITE_ENABLE_ECOMMERCE=false
#
# CMS del sitio público — grupo SEO en sidebar (`/seo/pages`). Por defecto activo; pon false para ocultarlo.
# VITE_ENABLE_SITE_CMS=false
#
# AI features (requires ai-task-summary Edge Function deployed in Supabase)
# When true: shows "Resumen IA" button in TasksPage
VITE_ENABLE_AI=false

# Entity / Workspace configuration
# Label that appears in UI for the main business entity (singular).
# Change this per deployment: "Proyecto", "Obra", "Cliente", "Caso", "Campaña"…
VITE_ENTITY_LABEL=Proyecto

# Optional: explicit plural form. If omitted, auto-derived (vowel→+s, consonant→+es).
# E.g. VITE_ENTITY_LABEL=Proyecto → auto "Proyectos" ✓
#      VITE_ENTITY_LABEL=Entidad  → auto "Entidades" ✓
# VITE_ENTITY_LABEL_PLURAL=Proyectos

# Set to "false" to hide the EntitySelector (single-entity deployments)
VITE_ENABLE_MULTI_ENTITY=true

# ───────────────────────────────────────────────────────────────────────────────
# Desarrollo local — ERP + Astro (`pnpm dev:all`). Matriz prod/staging/Vercel: docs/deployment-environments.md
# ───────────────────────────────────────────────────────────────────────────────
# Local: ERP :7020 · Astro :7021 (los del template; cada cliente usa su propio bloque
# del registro — ver la sección de puertos arriba)
#
# ─── Copiar a Vercel (Production) — ajusta dominios a los tuyos ───
# Proyecto ERP (Vite): VITE_PUBLIC_SITE_URL = URL pública del sitio (Astro)
# Proyecto Web (Astro build): PUBLIC_SITE_URL y PUBLIC_APP_URL obligatorios en prod
# VITE_PUBLIC_SITE_URL=https://www.tudominio.com
# PUBLIC_SITE_URL=https://www.tudominio.com
# PUBLIC_APP_URL=https://app.tudominio.com
#
# Desarrollo: localhost en PUBLIC_* sirve en la máquina del server; si abres el sitio
# desde el celular por IP (100.x, 192.168.x), los enlaces «Iniciar sesión» usan esa IP
# con el puerto del ERP automáticamente (ver astro/src/lib/public-urls.ts). ERP y Astro con host:true.

VITE_PUBLIC_SITE_URL=http://localhost:7021
PUBLIC_SITE_URL=http://localhost:7021
PUBLIC_APP_URL=http://localhost:7020

# Opcional — mismo .env es leído por astro/ (sin duplicar Supabase)
# Catálogo/carrito en sitio público Astro: true | false
PUBLIC_ENABLE_ECOMMERCE=false
# PUBLIC_BRAND_NAME=Mi Empresa
# PUBLIC_BRAND_ICON_URL=/pragmatadevs-icon.svg

#
# Chasis del template que Cuenta Aparte apaga (backport: los 3 flags nacen
# default=true, así que ningún cliente existente cambia de comportamiento).
# Cuenta Aparte los pone en "false" en su .env real: la comunicación
# cocina↔piso es el KDS (Hito 2), no un chat, y tasks/documents son demo.
# VITE_ENABLE_TASKS=false
# VITE_ENABLE_DOCUMENTS=false
# VITE_ENABLE_CHAT=false
