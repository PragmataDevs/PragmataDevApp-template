# App PragmataDevApp → Supabase NUBE.
# Se carga SOLO con `pnpm dev:cloud` (o `pnpm dev:all --cloud` → vite --mode cloud).
# Copia a .env.cloud y llena los valores:  cp .env.cloud.example .env.cloud
# Ignorado por git (.env.*). El anon key es público por diseño (protegido por RLS).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Feature flags (opcional; añade aquí los que use la app, ej: VITE_ENABLE_POWERSYNC=false)
