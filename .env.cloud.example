# Supabase NUBE — usado por dos flujos distintos que comparten este archivo:
#   1. `pnpm dev:cloud` (vite --mode cloud) → solo lee VITE_SUPABASE_URL/ANON_KEY
#      (públicas por diseño, protegidas por RLS) para apuntar el dev local a la nube.
#   2. `pnpm cloud:bootstrap` → lee TODO lo demás (secrets de alto privilegio) para
#      llevar el proyecto de local a producción. Ver docs/supabase-cloud-bootstrap.md.
#
# Copia a .env.cloud y llena los valores: cp .env.cloud.example .env.cloud
# Ignorado por git (.env.*). También puedes NO crear el archivo: cloud:bootstrap
# pide en terminal lo que falte (igual que SUPABASE_SERVICE_ROLE_KEY=... pnpm db:sync).

# ─── dev:cloud (públicas) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Feature flags (opcional; añade aquí los que use la app, ej: VITE_ENABLE_POWERSYNC=false)

# ─── cloud:bootstrap (alto privilegio — NUNCA en Vercel ni en el front) ────────
SUPABASE_SERVICE_ROLE_KEY=

# Management API — Auth Site URL / redirects (Dashboard → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=

# Usuario god (Auth + profiles.access_level=god)
GOD_USER_EMAIL=admin@tu-dominio.com
GOD_USER_PASSWORD=
GOD_USER_FULL_NAME=System Admin

# URLs producción (Auth + Vercel)
CLOUD_ERP_URL=https://app.tudominio.com
PUBLIC_SITE_URL=https://www.tudominio.com
PUBLIC_APP_URL=https://app.tudominio.com
VITE_PUBLIC_SITE_URL=https://www.tudominio.com
VITE_ENTITY_LABEL=

# Vercel CLI (opcional, con --with-vercel) — directorios con `vercel link`
VERCEL_ERP_CWD=.
VERCEL_ASTRO_CWD=astro

# ─── Integraciones Edge Functions (según scripts/supabase-cloud-manifest.ts) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
