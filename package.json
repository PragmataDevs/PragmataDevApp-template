{
  "name": "pragmata-dev-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:astro": "pnpm --dir astro dev",
    "dev:all": "bash scripts/dev-all.sh",
    "db:up": "bash scripts/dev-all.sh --db-up",
    "db:down": "bash scripts/dev-all.sh --db-down",
    "dev:cloud": "bash scripts/dev-all.sh --cloud",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:sync": "tsx scripts/sync-resources.ts",
    "db:sync-roles": "tsx scripts/sync-roles.ts",
    "validate:resources": "tsx scripts/validate-resources.ts",
    "cloud:bootstrap": "tsx scripts/supabase-cloud-bootstrap.ts",
    "cloud:deploy-functions": "tsx scripts/supabase-cloud-bootstrap.ts --skip-link --skip-push --skip-post-sql --skip-secrets --skip-sync --yes",
    "cloud:push-schema": "supabase db push",
    "ai:sync-prompts": "node scripts/sync-ai-prompts.mjs",
    "mapping:init": "node scripts/compose-mapping-prompt.mjs init",
    "mapping:prompt": "node scripts/compose-mapping-prompt.mjs prompt",
    "brand:sync": "cp public/pragmatadevs-icon.svg astro/public/pragmatadevs-icon.svg && cp public/pragmatadevs-icon.svg src/assets/brand-icon.svg && cp public/pragmatadevs-icon.svg public/favicon.svg && cp public/pragmatadevs-icon.svg astro/public/favicon.svg",
    "vercel:prod": "vercel deploy --prod -y",
    "vercel:prod:astro": "bash scripts/vercel-prod-astro.sh",
    "vercel:prod:all": "bash scripts/vercel-prod-all.sh",
    "cloud:stripe-setup": "tsx scripts/cloud/stripe-billing-setup.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@journeyapps/wa-sqlite": "^1.4.1",
    "@powersync/react": "^1.8.2",
    "@powersync/web": "^1.32.0",
    "@pragmata/core": "workspace:*",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "lucide-react": "^0.563.0",
    "marked": "^18.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7",
    "@supabase/supabase-js": "^2.94.1",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.8",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.1.2",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
