---
/**
 * Páginas Markdown públicas (`cms_pages.page_kind = standard`, publicadas).
 * Rutas estáticas (`/productos`, `/checkout`, …) tienen prioridad sobre este segmento.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PublicNav from '../components/public/PublicNav.astro';
import PublicFooter from '../components/public/PublicFooter.astro';
import { marked } from 'marked';
import { supabase } from '../lib/supabase';
import { resolveAppOrigin, resolveSiteOrigin } from '../lib/public-urls';

const slug = Astro.params.slug ?? '';
const RESERVED = new Set(['home']);

if (!slug || RESERVED.has(slug)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!supabase) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const siteUrl = resolveSiteOrigin(Astro.site, Astro.url);
const brandFallback = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';
const appUrl = resolveAppOrigin(Astro.url);
const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';
const pathname = Astro.url.pathname;

marked.setOptions({ gfm: true, breaks: true });

const { data: page, error } = await supabase
  .from('cms_pages')
  .select(
    'slug, seo_title, seo_description, og_image_url, body_markdown, page_kind, updated_at',
  )
  .eq('slug', slug)
  .eq('status', 'active')
  .maybeSingle();

const md = page?.body_markdown?.trim() ?? '';

if (error || !page || page.page_kind !== 'standard' || !md) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const html = marked.parse(md) as string;
const title =
  typeof page.seo_title === 'string' && page.seo_title.trim() ? page.seo_title.trim() : slug;
const description =
  typeof page.seo_description === 'string' && page.seo_description.trim()
    ? page.seo_description.trim()
    : `${title} — ${brandFallback}`;

const canonical = `${siteUrl.replace(/\/+$/, '')}/${encodeURIComponent(slug)}`;
const og =
  typeof page.og_image_url === 'string' && /^https?:\/\//i.test(page.og_image_url.trim())
    ? page.og_image_url.trim()
    : undefined;
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} image={og}>
  <div class="ps-mesh flex min-h-screen flex-col">
    <PublicNav
      brand={brandFallback}
      appUrl={appUrl}
      ecommerceEnabled={ecommerceEnabled}
      pathname={pathname}
    />

    <main class="flex-1">
      <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
        <div class="cms-md" set:html={html} />
      </article>
    </main>

    <PublicFooter
      brand={brandFallback}
      note={`${brandFallback} · Contenido legal e informativo.`}
      appUrl={appUrl}
      ecommerceEnabled={ecommerceEnabled}
    />
  </div>
</BaseLayout>
