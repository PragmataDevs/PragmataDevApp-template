---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PublicNav from '../components/public/PublicNav.astro';
import { PublicIcon } from '../components/icons/PublicIcon';
import { resolveAppOrigin, resolveSiteOrigin } from '../lib/public-urls';

const brand = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';

const appUrl = resolveAppOrigin(Astro.url);
const siteUrl = resolveSiteOrigin(Astro.site, Astro.url);
const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';
const pathname = Astro.url.pathname;

const sessionId = Astro.url.searchParams.get('session_id') ?? '';
---

<BaseLayout
  title="¡Gracias por tu compra!"
  description="Tu pedido fue procesado exitosamente."
  noindex={true}
  hideCart={true}
>
  <div class="ps-mesh flex min-h-screen flex-col">
    <PublicNav brand={brand} appUrl={appUrl} siteOrigin={siteUrl} ecommerceEnabled={ecommerceEnabled} pathname={pathname} />

    <main class="flex flex-1 items-center justify-center px-4 py-16 sm:px-6">
      <div class="w-full max-w-lg rounded-pragmata border border-brand-border bg-white/90 p-8 text-center shadow-psy-soft backdrop-blur-md sm:p-10 dark:bg-slate-900/88">
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-pragmata bg-gradient-to-br from-emerald-500 to-emerald-700 text-white shadow-lg"
          aria-hidden="true"
        >
          <PublicIcon name="check" className="h-8 w-8 text-white" />
        </div>
        <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-brand-dark sm:text-3xl">
          ¡Gracias por tu compra!
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-brand-steel sm:text-base">
          Tu pedido fue procesado correctamente. Recibirás un correo de confirmación en breve.
        </p>

        {
          sessionId && (
            <div class="mt-8 rounded-pragmata border border-brand-border bg-brand-surface px-4 py-3 text-left">
              <p class="font-mono text-[10px] font-semibold uppercase tracking-wider text-brand-steel">
                Referencia
              </p>
              <p class="mt-1 break-all font-mono text-xs text-brand-dark">{sessionId}</p>
            </div>
          )
        }

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a
            href="/productos"
            class="inline-flex items-center justify-center rounded-pragmata bg-brand-accent px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-accent-dark"
          >
            Seguir comprando
          </a>
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-pragmata border border-brand-border bg-white px-6 py-3 text-sm font-semibold text-brand-steel transition hover:border-brand-accent/30 hover:text-brand-dark dark:border-slate-600 dark:bg-slate-900 dark:hover:bg-slate-800"
          >
            Volver al inicio
          </a>
        </div>
        <p class="mt-8 text-xs text-brand-steel">¿Tienes alguna duda? Escríbenos y te ayudamos.</p>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  try {
    localStorage.removeItem('pragmata_cart');
    window.dispatchEvent(new CustomEvent('cart:updated', { detail: [] }));
  } catch (_) {
    /* ignore */
  }
</script>
