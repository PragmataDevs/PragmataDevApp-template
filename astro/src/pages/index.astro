---
/**
 * Landing — SSR cuando PUBLIC_SITE_URL está configurado (hybrid).
 * Copia publicada en `cms_pages.slug = home` sustituye textos; si no hay fila publicada, valores por defecto desde env.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { mergeLandingFromCms } from '../lib/cms-defaults';
import { marked } from 'marked';

function landingMdToHtml(md: string): string {
  const s = (md ?? '').trim();
  if (!s) return '';
  const out = marked.parse(s, { async: false });
  return typeof out === 'string' ? out : '';
}

const brandEnv    = import.meta.env.PUBLIC_BRAND_NAME    ?? 'Mi Empresa';
const taglineEnv = import.meta.env.PUBLIC_BRAND_TAGLINE ?? 'Tu solución de negocio';
const appUrl     = import.meta.env.PUBLIC_APP_URL       ?? 'https://app.tucliente.com';
const siteUrl    = import.meta.env.PUBLIC_SITE_URL      ?? 'https://tucliente.com';
const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';

let cmsHome: {
  is_published: boolean;
  seo_title: string | null;
  seo_description: string | null;
  og_image_url: string | null;
  content: Record<string, unknown>;
} | null = null;

try {
  const { data, error } = await supabase
    .from('cms_pages')
    .select('is_published, seo_title, seo_description, og_image_url, content')
    .eq('slug', 'home')
    .eq('status', 'active')
    .maybeSingle();

  if (!error && data?.is_published === true) {
    cmsHome = {
      is_published: true,
      seo_title: data.seo_title as string | null,
      seo_description: data.seo_description as string | null,
      og_image_url: data.og_image_url as string | null,
      content: (data.content && typeof data.content === 'object' ? data.content : {}) as Record<
        string,
        unknown
      >,
    };
  }
} catch {
  cmsHome = null;
}

const merged = mergeLandingFromCms({
  brandEnv,
  taglineEnv,
  ecommerceEnabled,
  cms: cmsHome,
});

const description = merged.metaDescription;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id':   `${siteUrl}/#website`,
      url:     siteUrl,
      name:    merged.brand,
      description,
      potentialAction: {
        '@type':       'SearchAction',
        target:        `${siteUrl}/productos?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id':   `${siteUrl}/#organization`,
      name:    merged.brand,
      url:     siteUrl,
      logo:    `${siteUrl}/logo.png`,
      sameAs:  [],
    },
  ],
};

const canonicalRoot = siteUrl.replace(/\/+$/, '') + '/';
const features = merged.features;
const heroSubHtml = landingMdToHtml(merged.heroSubheadline);
---

<BaseLayout
  title={merged.metaTitleBase}
  description={merged.metaDescription}
  canonicalUrl={canonicalRoot}
  schema={schema}
  image={merged.ogImage}
>
  <style is:global>
    .landing-hero-sub p { margin: 0 0 0.65em; }
    .landing-hero-sub p:last-child { margin-bottom: 0; }
    .landing-hero-sub a { color: var(--brand-accent); text-decoration: underline; text-underline-offset: 2px; }
    .landing-hero-sub strong { color: var(--brand-fg); }
  </style>
  <nav style="position:sticky;top:0;z-index:50;background:rgba(255,255,255,0.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--brand-border);">
    <div style="max-width:1100px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:60px;">
      <a href="/" style="font-size:1.125rem;font-weight:700;color:var(--brand-primary);text-decoration:none;">
        {merged.brand}
      </a>
      <div style="display:flex;align-items:center;gap:24px;">
        <a href="#features" style="font-size:0.875rem;color:var(--brand-muted);text-decoration:none;">Características</a>
        {ecommerceEnabled && (
          <a href="/productos" style="font-size:0.875rem;color:var(--brand-muted);text-decoration:none;">Productos</a>
        )}
        <a href="#pricing" style="font-size:0.875rem;color:var(--brand-muted);text-decoration:none;">Precios</a>
        <a
          href={`${appUrl}/login`}
          style="display:inline-flex;align-items:center;padding:8px 18px;font-size:0.875rem;font-weight:600;color:#fff;background:var(--brand-accent);border-radius:8px;text-decoration:none;"
        >
          Iniciar sesión
        </a>
      </div>
    </div>
  </nav>

  <section style="padding:80px 24px 60px;text-align:center;max-width:800px;margin:0 auto;">
    <div style="display:inline-block;margin-bottom:20px;padding:6px 16px;background:var(--brand-accent);color:#fff;font-size:0.75rem;font-weight:600;border-radius:100px;letter-spacing:0.05em;text-transform:uppercase;">
      {merged.heroBadge}
    </div>
    <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:800;line-height:1.15;color:var(--brand-fg);margin:0 0 24px;letter-spacing:-0.02em;">
      {merged.heroHeadline}
    </h1>
    <div
      class="landing-hero-sub"
      set:html={heroSubHtml}
      style="font-size:1.125rem;color:var(--brand-muted);max-width:600px;margin:0 auto 40px;line-height:1.7;"
    />
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
      <a
        href={`${appUrl}/login`}
        style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;font-size:1rem;font-weight:600;color:#fff;background:var(--brand-accent);border-radius:10px;text-decoration:none;box-shadow:0 4px 14px rgba(26,127,240,0.35);"
      >
        {merged.primaryCtaLabel}
      </a>
      <a
        href={merged.secondaryCtaHref}
        style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;font-size:1rem;font-weight:500;color:var(--brand-fg);background:var(--brand-surface);border:1px solid var(--brand-border);border-radius:10px;text-decoration:none;"
      >
        {merged.secondaryCtaLabel}
      </a>
    </div>
  </section>

  <div style="border-top:1px solid var(--brand-border);border-bottom:1px solid var(--brand-border);padding:16px 24px;text-align:center;background:var(--brand-surface);">
    <p style="font-size:0.875rem;color:var(--brand-muted);margin:0;">
      {merged.socialProofBar}
    </p>
  </div>

  <section id="features" style="padding:80px 24px;max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:56px;">
      <h2 style="font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;color:var(--brand-fg);margin:0 0 12px;">
        {merged.featuresIntroTitle}
      </h2>
      <p style="font-size:1rem;color:var(--brand-muted);max-width:500px;margin:0 auto;">
        {merged.featuresIntroSubtitle}
      </p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
      {features.map((f) => (
        f.href ? (
          <a
            href={f.href}
            style="padding:28px;border:1px solid var(--brand-border);border-radius:12px;background:var(--brand-surface);transition:box-shadow 0.2s,transform 0.15s;text-decoration:none;display:block;"
            onmouseover="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.08)';this.style.transform='translateY(-2px)'"
            onmouseout="this.style.boxShadow='none';this.style.transform='none'"
          >
            <div style="font-size:2rem;margin-bottom:12px;">{f.icon}</div>
            <h3 style="font-size:1rem;font-weight:600;color:var(--brand-fg);margin:0 0 8px;">{f.title}</h3>
            <p style="font-size:0.875rem;color:var(--brand-muted);margin:0 0 12px;line-height:1.6;">{f.description}</p>
            <span style="font-size:0.8125rem;font-weight:600;color:var(--brand-accent);">
              {f.href === '/productos' ? 'Ver productos →' : 'Ver más →'}
            </span>
          </a>
        ) : (
          <div style="padding:28px;border:1px solid var(--brand-border);border-radius:12px;background:var(--brand-surface);">
            <div style="font-size:2rem;margin-bottom:12px;">{f.icon}</div>
            <h3 style="font-size:1rem;font-weight:600;color:var(--brand-fg);margin:0 0 8px;">{f.title}</h3>
            <p style="font-size:0.875rem;color:var(--brand-muted);margin:0;line-height:1.6;">{f.description}</p>
          </div>
        )
      ))}
    </div>
  </section>

  <section id="pricing" style="padding:80px 24px;background:var(--brand-primary);text-align:center;">
    <h2 style="font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;color:#fff;margin:0 0 16px;">
      {merged.pricingTitle}
    </h2>
    <p style="font-size:1rem;color:rgba(255,255,255,0.7);max-width:500px;margin:0 auto 36px;">
      {merged.pricingSubtitle}
    </p>
    <a
      href={`${appUrl}/login`}
      style="display:inline-flex;align-items:center;gap:8px;padding:16px 36px;font-size:1rem;font-weight:700;color:var(--brand-primary);background:#fff;border-radius:10px;text-decoration:none;box-shadow:0 4px 20px rgba(0,0,0,0.25);"
    >
      Crear mi cuenta gratis →
    </a>
  </section>

  <footer style="padding:40px 24px;border-top:1px solid var(--brand-border);background:var(--brand-surface);">
    <div style="max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;">
      <p style="font-size:0.875rem;color:var(--brand-muted);margin:0;">
        {merged.footerNote}
      </p>
      <div style="display:flex;gap:24px;flex-wrap:wrap;">
        {ecommerceEnabled && (
          <a href="/productos" style="font-size:0.875rem;color:var(--brand-muted);text-decoration:none;">Productos</a>
        )}
        <a href="/privacidad" style="font-size:0.875rem;color:var(--brand-muted);text-decoration:none;">Privacidad</a>
        <a href="/terminos"   style="font-size:0.875rem;color:var(--brand-muted);text-decoration:none;">Términos</a>
        <a href={`${appUrl}/login`} style="font-size:0.875rem;color:var(--brand-accent);text-decoration:none;">Iniciar sesión</a>
      </div>
    </div>
  </footer>
</BaseLayout>
