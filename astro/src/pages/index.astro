---
/**
 * Landing — SSR cuando PUBLIC_SITE_URL está configurado (hybrid).
 * Copia publicada en `cms_pages.slug = home` sustituye textos; si no hay fila publicada, valores por defecto desde env.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PublicNav from '../components/public/PublicNav.astro';
import PublicFooter from '../components/public/PublicFooter.astro';
import { PublicIcon } from '../components/icons/PublicIcon';
import { supabase } from '../lib/supabase';
import { mergeLandingFromCms } from '../lib/cms-defaults';
import { erpLoginUrl, resolveAppOrigin, resolveSiteOrigin } from '../lib/public-urls';
import { marked } from 'marked';

function landingMdToHtml(md: string): string {
  const s = (md ?? '').trim();
  if (!s) return '';
  const out = marked.parse(s, { async: false });
  return typeof out === 'string' ? out : '';
}

const brandEnv = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';
const taglineEnv = import.meta.env.PUBLIC_BRAND_TAGLINE ?? 'Tu solución de negocio';
const brandIconEnv = typeof import.meta.env.PUBLIC_BRAND_ICON_URL === 'string' ? import.meta.env.PUBLIC_BRAND_ICON_URL.trim() : '';
const appUrl = resolveAppOrigin(Astro.url);
const siteUrl = resolveSiteOrigin(Astro.site, Astro.url);
const loginUrl = erpLoginUrl(appUrl, siteUrl);
const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';
const pathname = Astro.url.pathname;

let cmsHome: {
  is_published: boolean;
  seo_title: string | null;
  seo_description: string | null;
  og_image_url: string | null;
  content: Record<string, unknown>;
} | null = null;

try {
  if (supabase) {
    const { data, error } = await supabase
      .from('cms_pages')
      .select('is_published, seo_title, seo_description, og_image_url, content')
      .eq('slug', 'home')
      .eq('status', 'active')
      .maybeSingle();

    if (!error && data?.is_published === true) {
      cmsHome = {
        is_published: true,
        seo_title: data.seo_title as string | null,
        seo_description: data.seo_description as string | null,
        og_image_url: data.og_image_url as string | null,
        content: (data.content && typeof data.content === 'object' ? data.content : {}) as Record<
          string,
          unknown
        >,
      };
    }
  }
} catch {
  cmsHome = null;
}

const merged = mergeLandingFromCms({
  brandEnv,
  taglineEnv,
  ecommerceEnabled,
  cms: cmsHome,
});

const description = merged.metaDescription;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: merged.brand,
      description,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/productos?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: merged.brand,
      url: siteUrl,
      ...(brandIconEnv
        ? {
            logo: `${siteUrl}${brandIconEnv.startsWith('/') ? brandIconEnv : `/${brandIconEnv}`}`,
          }
        : {}),
      sameAs: [],
    },
  ],
};

const canonicalRoot = siteUrl.replace(/\/+$/, '') + '/';
const features = merged.features;
const heroSubHtml = landingMdToHtml(merged.heroSubheadline);
const featTotal = features.length;
---

<BaseLayout
  title={merged.metaTitleBase}
  description={merged.metaDescription}
  canonicalUrl={canonicalRoot}
  schema={schema}
  image={merged.ogImage}
>
  <div class="ps-mesh flex min-h-screen flex-col">
    <PublicNav
      brand={merged.brand}
      appUrl={appUrl}
      siteOrigin={siteUrl}
      ecommerceEnabled={ecommerceEnabled}
      pathname={pathname}
    />

    <main class="flex-1">
      <!-- Hero -->
      <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-20">
        <div class="animate-ps-fade-up mx-auto max-w-3xl text-center">
          <p
            class="mb-5 inline-flex items-center rounded-pragmata border border-brand-accent/25 bg-brand-accent/10 px-3 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-accent-dark"
          >
            {merged.heroBadge}
          </p>
          <h1
            class="text-balance bg-gradient-to-b from-brand-dark to-brand-dark/80 bg-clip-text text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl lg:text-6xl"
          >
            {merged.heroHeadline}
          </h1>
          <div
            class="landing-hero-sub mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-brand-steel"
            set:html={heroSubHtml}
          />
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a
              href={loginUrl}
              class="inline-flex items-center justify-center rounded-pragmata bg-brand-accent px-7 py-3.5 text-base font-semibold text-white shadow-psy-glow transition hover:bg-brand-accent-dark hover:shadow-psy-glow-lg"
            >
              {merged.primaryCtaLabel}
            </a>
            <a
              href={merged.secondaryCtaHref}
              class="inline-flex items-center justify-center rounded-pragmata border border-brand-border bg-white/80 px-7 py-3.5 text-base font-medium text-brand-dark shadow-sm backdrop-blur-sm transition hover:border-brand-accent/30 hover:bg-white dark:border-slate-600 dark:bg-slate-900/85 dark:hover:bg-slate-800"
            >
              {merged.secondaryCtaLabel}
            </a>
          </div>
        </div>
      </section>

      <!-- Social proof -->
      <div
        class="border-y border-brand-border/80 bg-white/60 py-4 text-center font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-brand-steel/90 backdrop-blur-sm dark:bg-slate-900/45"
      >
        {merged.socialProofBar}
      </div>

      <!-- Bento features -->
      <section id="features" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
        <header class="mx-auto mb-12 max-w-2xl text-center">
          <h2 class="text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl">
            {merged.featuresIntroTitle}
          </h2>
          <p class="mt-3 text-pretty text-brand-steel sm:text-lg">
            {merged.featuresIntroSubtitle}
          </p>
        </header>

        <div
          class:list={[
            'grid auto-rows-fr gap-4',
            featTotal >= 4 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2',
          ]}
        >
          {
            features.map((f, i) =>
              f.href ? (
                <a
                  href={f.href}
                  class:list={[
                    'bento-feature-card',
                    featTotal >= 4 && i === 0 && 'sm:col-span-2 sm:row-span-2 sm:min-h-[280px]',
                    featTotal === 3 && i === 0 && 'sm:col-span-2 sm:row-span-2 sm:min-h-[240px]',
                  ]}
                >
                  <div class="bento-feature-icon-wrap" aria-hidden="true">
                    <PublicIcon name={f.icon} className="h-5 w-5" />
                  </div>
                  <h3 class="bento-feature-title">{f.title}</h3>
                  <p class="bento-feature-body">{f.description}</p>
                  <span class="bento-feature-cta">
                    {f.href === '/productos' ? 'Ver productos →' : 'Ver más →'}
                  </span>
                </a>
              ) : (
                <div
                  class:list={[
                    'bento-feature-card',
                    featTotal >= 4 && i === 0 && 'sm:col-span-2 sm:row-span-2 sm:min-h-[280px]',
                    featTotal === 3 && i === 0 && 'sm:col-span-2 sm:row-span-2 sm:min-h-[240px]',
                  ]}
                >
                  <div class="bento-feature-icon-wrap" aria-hidden="true">
                    <PublicIcon name={f.icon} className="h-5 w-5" />
                  </div>
                  <h3 class="bento-feature-title">{f.title}</h3>
                  <p class="bento-feature-body">{f.description}</p>
                </div>
              ),
            )
          }
        </div>
      </section>

      <!-- Pricing CTA -->
      <section id="pricing" class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-28">
        <div
          class="relative overflow-hidden rounded-pragmata border border-slate-700/80 bg-slate-900 px-6 py-16 text-center shadow-psy-glow-lg sm:px-12 sm:py-20"
        >
          <div
            class="pointer-events-none absolute -left-24 -top-24 h-64 w-64 rounded-full bg-brand-accent/25 blur-3xl"
            aria-hidden="true"
          />
          <div
            class="pointer-events-none absolute -bottom-20 -right-16 h-56 w-56 rounded-full bg-sky-400/15 blur-3xl"
            aria-hidden="true"
          />
          <div class="relative">
            <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
              {merged.pricingTitle}
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-pretty text-lg text-slate-300">
              {merged.pricingSubtitle}
            </p>
            <a
              href={loginUrl}
              class="mt-10 inline-flex items-center justify-center rounded-pragmata bg-white px-8 py-4 text-base font-bold text-slate-900 shadow-lg transition hover:bg-slate-100"
            >
              Crear mi cuenta gratis →
            </a>
          </div>
        </div>
      </section>
    </main>

    <PublicFooter
      brand={merged.brand}
      note={merged.footerNote}
      appUrl={appUrl}
      siteOrigin={siteUrl}
      ecommerceEnabled={ecommerceEnabled}
    />
  </div>
</BaseLayout>
