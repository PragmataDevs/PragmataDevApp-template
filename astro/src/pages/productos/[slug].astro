---
/**
 * /productos/[slug] — Product detail page.
 */
export const prerender = false;

import type { Product } from '@pragmata/core';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicNav from '../../components/public/PublicNav.astro';
import PublicFooter from '../../components/public/PublicFooter.astro';
import { PublicIcon } from '../../components/icons/PublicIcon';
import CartButton from '../../components/islands/CartButton';
import { supabase } from '../../lib/supabase';
import { resolveAppOrigin, resolveSiteOrigin } from '../../lib/public-urls';

if (!supabase) {
  return Astro.redirect('/productos?notfound=1', 302);
}

function truncateMeta(text: string, max = 160): string {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  return `${t.slice(0, Math.max(0, max - 1)).trimEnd()}…`;
}

const { slug } = Astro.params;

const { data: row, error } = await supabase
  .from('products')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'active')
  .single();

const product = row as Product | null;

if (error || !product) {
  return Astro.redirect('/productos?notfound=1', 302);
}

const origin = resolveSiteOrigin(Astro.site, Astro.url);
const currency = product.currency ?? 'MXN';
const pathname = Astro.url.pathname;

const metaTitle =
  typeof product.seo_title === 'string' && product.seo_title.trim()
    ? product.seo_title.trim()
    : product.name;

const plainForSnippet =
  (typeof product.seo_description === 'string' && product.seo_description.trim()) ||
  (typeof product.description === 'string' && product.description.trim()) ||
  `Compra ${product.name} en nuestra tienda`;

const metaDesc = truncateMeta(plainForSnippet, 160);
const schemaDesc = truncateMeta(plainForSnippet, 4000);

const ogImage =
  (typeof product.seo_image_url === 'string' && product.seo_image_url.trim())
    ? product.seo_image_url.trim()
    : product.image_url ?? undefined;

const canonicalUrl = `${origin}/productos/${encodeURIComponent(product.slug)}`;

const priceFormatted = new Intl.NumberFormat('es-MX', { style: 'currency', currency }).format(
  product.price,
);
const compareFormatted = product.compare_at_price
  ? new Intl.NumberFormat('es-MX', { style: 'currency', currency }).format(product.compare_at_price)
  : null;

const discount =
  product.compare_at_price && product.compare_at_price > product.price
    ? Math.round((1 - product.price / product.compare_at_price) * 100)
    : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: schemaDesc,
  image: ogImage ?? `${origin}/og-default.png`,
  url: canonicalUrl,
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: currency,
    availability: product.in_stock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    url: canonicalUrl,
  },
};

const brand = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';
const appUrl = resolveAppOrigin(Astro.url);
const tagline = import.meta.env.PUBLIC_BRAND_TAGLINE ?? '';
const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';

const lowStockQty =
  product.in_stock &&
  product.stock_qty != null &&
  product.stock_qty < 6
    ? product.stock_qty
    : null;
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  image={ogImage ?? undefined}
  canonicalUrl={canonicalUrl}
  type="product"
  schema={schema}
>
  <div class="ps-mesh flex min-h-screen flex-col">
    <PublicNav brand={brand} appUrl={appUrl} siteOrigin={origin} ecommerceEnabled={ecommerceEnabled} pathname={pathname} />

    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
        <nav class="mb-8 flex flex-wrap items-center gap-1 text-xs font-medium text-brand-steel sm:text-sm">
          <a href="/" class="transition hover:text-brand-dark">Inicio</a>
          <span class="text-slate-400">/</span>
          <a href="/productos" class="transition hover:text-brand-dark">Productos</a>
          {
            product.category && (
              <span class="text-slate-400">/</span>
            )
          }
          {
            product.category && (
              <a
                href={`/productos?categoria=${encodeURIComponent(product.category)}`}
                class="transition hover:text-brand-dark"
              >
                {product.category}
              </a>
            )
          }
          <span class="text-slate-400">/</span>
          <span class="text-brand-dark">{product.name}</span>
        </nav>

        <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
          <div class="space-y-3">
            <div
              class="overflow-hidden rounded-pragmata border border-brand-border bg-brand-surface shadow-sm"
            >
              <div class="aspect-square product-detail-media-fallback">
                {
                  product.image_url ? (
                    <img
                      src={product.image_url}
                      alt={product.name}
                      class="h-full w-full object-cover"
                      loading="eager"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center text-slate-300">
                      <PublicIcon name="package" className="h-16 w-16" />
                    </div>
                  )
                }
              </div>
            </div>

            {
              Array.isArray(product.images) && product.images.length > 1 && (
                <div class="flex gap-2 overflow-x-auto pb-1">
                  {product.images.slice(0, 6).map((img: string) => (
                    <img
                      src={img}
                      alt={product.name}
                      class="h-16 w-16 shrink-0 rounded-pragmata border border-brand-border object-cover"
                      loading="lazy"
                    />
                  ))}
                </div>
              )
            }
          </div>

          <div>
            {
              product.category && (
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-accent-dark">
                  {product.category}
                </p>
              )
            }
            <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl">
              {product.name}
            </h1>

            <div class="mt-6 flex flex-wrap items-baseline gap-3">
              <span class="text-3xl font-extrabold tabular-nums text-brand-dark sm:text-4xl">
                {priceFormatted}
              </span>
              <span class="text-sm font-medium text-brand-steel">{currency}</span>
              {
                compareFormatted && (
                  <span class="text-lg text-brand-steel line-through">{compareFormatted}</span>
                )
              }
              {
                discount && (
                  <span class="rounded-pragmata bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-800">
                    −{discount}%
                  </span>
                )
              }
            </div>

            {
              product.description && (
                <p class="mt-6 text-base leading-relaxed text-brand-steel">{product.description}</p>
              )
            }

            <div class="mt-6">
              {
                product.in_stock ? (
                  <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-emerald-700">
                    <PublicIcon name="check" className="h-4 w-4 shrink-0 text-emerald-600" />
                    <span>
                      En stock
                      {lowStockQty != null && ` · Solo quedan ${lowStockQty}`}
                    </span>
                  </p>
                ) : (
                  <p class="text-sm font-medium text-red-600">Sin stock — agotado temporalmente</p>
                )
              }
            </div>

            <div class="mt-8 max-w-md">
              <CartButton
                client:load
                product={{
                  id: product.id,
                  name: product.name,
                  price: product.price,
                  slug: product.slug,
                  image: product.image_url ?? undefined,
                }}
                disabled={!product.in_stock}
              />
            </div>

            <div
              class="catalog-filter-panel mt-8 grid gap-3 p-4 text-sm text-brand-steel sm:grid-cols-3"
            >
              <span class="inline-flex items-center gap-2">
                <PublicIcon name="lock" className="h-4 w-4 shrink-0 text-brand-accent" />
                Pago seguro
              </span>
              <span class="inline-flex items-center gap-2">
                <PublicIcon name="truck" className="h-4 w-4 shrink-0 text-brand-accent" />
                Envío acordado
              </span>
              <span class="inline-flex items-center gap-2">
                <PublicIcon name="message-circle" className="h-4 w-4 shrink-0 text-brand-accent" />
                Soporte
              </span>
            </div>
          </div>
        </div>
      </div>
    </main>

    <PublicFooter
      brand={brand}
      note={tagline || `${brand} · Tienda pública`}
      appUrl={appUrl}
      siteOrigin={origin}
      ecommerceEnabled={ecommerceEnabled}
    />
  </div>
</BaseLayout>
