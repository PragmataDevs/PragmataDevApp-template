---
/**
 * /productos — Product catalog (SSR with URL-based filters).
 *
 * SSR so filters (category, search, sort) are reflected in the URL and
 * can be indexed by search engines per category page.
 *
 * Data: fetched live from public.products (Supabase anon key — public RLS).
 * Schema.org: ItemList for the catalog page.
 */
export const prerender = false; // SSR — dynamic per request

import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

// ── URL filter params ────────────────────────────────────────────────────────
const url       = Astro.url;
const searchQ   = url.searchParams.get('q')        ?? '';
const category  = url.searchParams.get('categoria') ?? '';
const sort      = url.searchParams.get('orden')     ?? 'nombre';

// ── Fetch products from Supabase ─────────────────────────────────────────────
let query = supabase
  .from('products')
  .select('id, name, slug, price, compare_at_price, currency, description, image_url, category, in_stock')
  .eq('status', 'active');

if (searchQ)  query = query.ilike('name', `%${searchQ}%`);
if (category) query = query.eq('category', category);

if (sort === 'precio_asc')  query = query.order('price', { ascending: true });
else if (sort === 'precio_desc') query = query.order('price', { ascending: false });
else                             query = query.order('name',  { ascending: true });

const { data: productsRaw } = await query;
const products = productsRaw ?? [];

// ── Get all categories for the filter dropdown ───────────────────────────────
const { data: catRowsRaw } = await supabase
  .from('products')
  .select('category')
  .eq('status', 'active')
  .not('category', 'is', null);

const catRows = catRowsRaw ?? [];
const categories = [...new Set(catRows.map((r: { category: string | null }) => r.category).filter(Boolean))] as string[];

const brand   = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';
const siteUrl = import.meta.env.PUBLIC_SITE_URL   ?? '';

// ── Schema.org ItemList ───────────────────────────────────────────────────────
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Catálogo de productos — ${brand}`,
  itemListElement: products.map((p: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      description: p.description,
      url: `${siteUrl}/productos/${p.slug}`,
    },
  })),
};
---

<BaseLayout
  title="Catálogo de Productos"
  description={`Explora nuestro catálogo. ${products.length} producto${products.length !== 1 ? 's' : ''} disponible${products.length !== 1 ? 's' : ''}.`}
  schema={schema}
>
  <div style="max-width:1100px;margin:0 auto;padding:40px 24px;">

    <!-- Header -->
    <div style="margin-bottom:32px;">
      <h1 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:700;color:var(--brand-fg);margin:0 0 8px;">
        Nuestros Productos
      </h1>
      <p style="color:var(--brand-muted);font-size:0.875rem;">{products.length} productos disponibles</p>
    </div>

    <!-- Filters bar -->
    <form method="get" style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:32px;padding:16px;background:var(--brand-surface);border:1px solid var(--brand-border);border-radius:10px;">
      <input
        type="search"
        name="q"
        value={searchQ}
        placeholder="Buscar productos..."
        style="flex:1;min-width:180px;padding:8px 14px;border:1px solid var(--brand-border);border-radius:8px;font-size:0.875rem;"
      />
      {categories.length > 0 && (
        <select name="categoria" style="padding:8px 14px;border:1px solid var(--brand-border);border-radius:8px;font-size:0.875rem;background:#fff;">
          <option value="">Todas las categorías</option>
          {categories.map(cat => (
            <option value={cat} selected={category === cat}>{cat}</option>
          ))}
        </select>
      )}
      <select name="orden" style="padding:8px 14px;border:1px solid var(--brand-border);border-radius:8px;font-size:0.875rem;background:#fff;">
        <option value="nombre"       selected={sort === 'nombre'}>Nombre A-Z</option>
        <option value="precio_asc"   selected={sort === 'precio_asc'}>Precio: menor a mayor</option>
        <option value="precio_desc"  selected={sort === 'precio_desc'}>Precio: mayor a menor</option>
      </select>
      <button type="submit" style="padding:8px 20px;background:var(--brand-accent);color:#fff;border:none;border-radius:8px;font-size:0.875rem;font-weight:600;cursor:pointer;">
        Filtrar
      </button>
    </form>

    <!-- Product grid -->
    {products.length === 0 ? (
      <div style="text-align:center;padding:80px 0;color:var(--brand-muted);">
        <div style="font-size:3rem;margin-bottom:16px;">🛍️</div>
        <p style="margin:0 0 12px;font-weight:500;">
          {searchQ || category ? 'No se encontraron productos con esos filtros.' : 'No hay productos disponibles aún.'}
        </p>
        {(searchQ || category) && (
          <a href="/productos" style="color:var(--brand-accent);font-size:0.875rem;">Ver todos los productos</a>
        )}
      </div>
    ) : (
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px;">
        {(products as any[]).map(product => (
          <a
            href={`/productos/${product.slug}`}
            style="display:block;border:1px solid var(--brand-border);border-radius:12px;background:var(--brand-surface);overflow:hidden;text-decoration:none;transition:box-shadow 0.2s,transform 0.15s;"
            onmouseover="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.08)';this.style.transform='translateY(-2px)'"
            onmouseout="this.style.boxShadow='none';this.style.transform='none'"
          >
            <!-- Product image -->
            <div style="aspect-ratio:4/3;background:var(--brand-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;">
              {product.image_url
                ? <img src={product.image_url} alt={product.name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                : <span style="font-size:3rem;">🛍️</span>
              }
            </div>
            <!-- Product info -->
            <div style="padding:16px;">
              {product.category && (
                <p style="font-size:0.75rem;color:var(--brand-muted);margin:0 0 4px;text-transform:uppercase;letter-spacing:0.05em;">{product.category}</p>
              )}
              <h2 style="font-size:0.9375rem;font-weight:600;color:var(--brand-fg);margin:0 0 8px;">{product.name}</h2>
              {product.description && (
                <p style="font-size:0.8125rem;color:var(--brand-muted);margin:0 0 12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{product.description}</p>
              )}
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <div>
                  <span style="font-size:1.125rem;font-weight:700;color:var(--brand-fg);">
                    {new Intl.NumberFormat('es-MX', { style: 'currency', currency: product.currency ?? 'MXN' }).format(product.price)}
                  </span>
                  {product.compare_at_price && (
                    <span style="font-size:0.75rem;color:var(--brand-muted);text-decoration:line-through;margin-left:6px;">
                      {new Intl.NumberFormat('es-MX', { style: 'currency', currency: product.currency ?? 'MXN' }).format(product.compare_at_price)}
                    </span>
                  )}
                </div>
                <span style="font-size:0.75rem;font-weight:600;color:var(--brand-accent);">Ver →</span>
              </div>
              {!product.in_stock && (
                <p style="font-size:0.75rem;color:#ef4444;margin:8px 0 0;font-weight:500;">Sin stock</p>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
