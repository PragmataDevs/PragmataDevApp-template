---
/**
 * /productos — Product catalog (SSR with URL-based filters).
 */
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicNav from '../../components/public/PublicNav.astro';
import PublicFooter from '../../components/public/PublicFooter.astro';
import { PublicIcon } from '../../components/icons/PublicIcon';
import { supabase } from '../../lib/supabase';
import { resolveAppOrigin, resolveSiteOrigin } from '../../lib/public-urls';

const url = Astro.url;
const searchQ = url.searchParams.get('q') ?? '';
const category = url.searchParams.get('categoria') ?? '';
const sort = url.searchParams.get('orden') ?? 'nombre';
const pathname = url.pathname;

type CatalogProduct = {
  id: string;
  name: string;
  slug: string;
  price: number;
  compare_at_price: number | null;
  currency: string | null;
  description: string | null;
  image_url: string | null;
  category: string | null;
  in_stock: boolean;
};

let products: CatalogProduct[] = [];
let categories: string[] = [];

if (supabase) {
  let query = supabase
    .from('products')
    .select('id, name, slug, price, compare_at_price, currency, description, image_url, category, in_stock')
    .eq('status', 'active');

  if (searchQ) query = query.ilike('name', `%${searchQ}%`);
  if (category) query = query.eq('category', category);

  if (sort === 'precio_asc') query = query.order('price', { ascending: true });
  else if (sort === 'precio_desc') query = query.order('price', { ascending: false });
  else query = query.order('name', { ascending: true });

  const { data: productsRaw } = await query;
  products = (productsRaw ?? []) as CatalogProduct[];

  const { data: catRowsRaw } = await supabase
    .from('products')
    .select('category')
    .eq('status', 'active')
    .not('category', 'is', null);

  const catRows = catRowsRaw ?? [];
  categories = [
    ...new Set(catRows.map((r: { category: string | null }) => r.category).filter(Boolean)),
  ] as string[];
}

const brand = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';
const appUrl = resolveAppOrigin(Astro.url);
const siteUrl = resolveSiteOrigin(Astro.site, Astro.url);
const tagline = import.meta.env.PUBLIC_BRAND_TAGLINE ?? 'Catálogo y checkout seguros.';
const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Catálogo de productos — ${brand}`,
  itemListElement: products.map((p: { name: string; description: string | null; slug: string }, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      description: p.description,
      url: `${siteUrl}/productos/${p.slug}`,
    },
  })),
};
---

<BaseLayout
  title="Catálogo de Productos"
  description={`Explora nuestro catálogo. ${products.length} producto${products.length !== 1 ? 's' : ''} disponible${products.length !== 1 ? 's' : ''}.`}
  schema={schema}
>
  <div class="ps-mesh flex min-h-screen flex-col">
    <PublicNav brand={brand} appUrl={appUrl} siteOrigin={siteUrl} ecommerceEnabled={ecommerceEnabled} pathname={pathname} />

    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
        <header class="mb-10 max-w-2xl">
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-accent-dark">
            Tienda
          </p>
          <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl">
            Nuestros productos
          </h1>
          <p class="mt-2 text-sm text-brand-steel sm:text-base">
            {products.length} producto{products.length !== 1 ? 's' : ''} disponible{products.length !== 1
              ? 's'
              : ''}
            {searchQ && ` · Resultados para “${searchQ}”`}
          </p>
        </header>

        <form
          method="get"
          class="catalog-filter-panel mb-10 flex flex-col gap-3 p-4 sm:flex-row sm:flex-wrap sm:items-end"
        >
          <label class="min-w-[200px] flex-1">
            <span class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-wider text-brand-steel"
              >Buscar</span
            >
            <input
              type="search"
              name="q"
              value={searchQ}
              placeholder="Nombre del producto…"
              class="catalog-filter-field w-full ring-brand-accent/30 transition focus:border-brand-accent focus:ring-2"
            />
          </label>
          {
            categories.length > 0 && (
              <label class="min-w-[160px] sm:max-w-[220px]">
                <span class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-wider text-brand-steel">
                  Categoría
                </span>
                <select
                  name="categoria"
                  class="catalog-filter-field focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/30"
                >
                  <option value="">Todas</option>
                  {categories.map(cat => (
                    <option value={cat} selected={category === cat}>
                      {cat}
                    </option>
                  ))}
                </select>
              </label>
            )
          }
          <label class="min-w-[160px] sm:max-w-[220px]">
            <span class="mb-1 block font-mono text-[10px] font-semibold uppercase tracking-wider text-brand-steel"
              >Orden</span
            >
            <select
              name="orden"
              class="catalog-filter-field focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/30"
            >
              <option value="nombre" selected={sort === 'nombre'}>Nombre A-Z</option>
              <option value="precio_asc" selected={sort === 'precio_asc'}>Precio: menor a mayor</option>
              <option value="precio_desc" selected={sort === 'precio_desc'}>Precio: mayor a menor</option>
            </select>
          </label>
          <button
            type="submit"
            class="rounded-pragmata bg-brand-accent px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-accent-dark hover:shadow-psy-glow sm:shrink-0"
          >
            Aplicar
          </button>
        </form>

        {
          products.length === 0 ? (
            <div class="catalog-empty-state py-20 text-center">
              <PublicIcon name="package" className="mx-auto h-12 w-12 text-slate-300" />
              <p class="catalog-empty-state__text mt-4">
                {searchQ || category
                  ? 'No se encontraron productos con esos filtros.'
                  : 'No hay productos disponibles aún.'}
              </p>
              {(searchQ || category) && (
                <a
                  href="/productos"
                  class="mt-4 inline-block text-sm font-semibold text-brand-accent hover:text-brand-accent-dark"
                >
                  Ver todos los productos
                </a>
              )}
            </div>
          ) : (
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {products.map(
                (product: {
                  slug: string;
                  image_url: string | null;
                  name: string;
                  category: string | null;
                  description: string | null;
                  price: number;
                  currency: string | null;
                  compare_at_price: number | null;
                  in_stock: boolean;
                }) => (
                  <a
                    href={`/productos/${product.slug}`}
                    class="group catalog-product-card"
                  >
                    <div class="catalog-product-card__media">
                      {product.image_url ? (
                        <img
                          src={product.image_url}
                          alt={product.name}
                          class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center text-slate-300">
                          <PublicIcon name="package" className="h-14 w-14" />
                        </div>
                      )}
                      {!product.in_stock && (
                        <span class="absolute left-2 top-2 rounded-pragmata bg-red-600/95 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">
                          Agotado
                        </span>
                      )}
                    </div>
                    <div class="catalog-product-card__body">
                      {product.category && (
                        <p class="catalog-product-card__category">{product.category}</p>
                      )}
                      <h2 class="catalog-product-card__title">{product.name}</h2>
                      {product.description && (
                        <p class="catalog-product-card__desc">{product.description}</p>
                      )}
                      <div class="catalog-product-card__footer">
                        <div>
                          <span class="catalog-product-card__price">
                            {new Intl.NumberFormat('es-MX', {
                              style: 'currency',
                              currency: product.currency ?? 'MXN',
                            }).format(product.price)}
                          </span>
                          {product.compare_at_price && (
                            <span class="catalog-product-card__compare">
                              {new Intl.NumberFormat('es-MX', {
                                style: 'currency',
                                currency: product.currency ?? 'MXN',
                              }).format(product.compare_at_price)}
                            </span>
                          )}
                        </div>
                        <span class="catalog-product-card__link">Ver →</span>
                      </div>
                    </div>
                  </a>
                ),
              )}
            </div>
          )
        }
      </div>
    </main>

    <PublicFooter brand={brand} note={tagline} appUrl={appUrl} siteOrigin={siteUrl} ecommerceEnabled={ecommerceEnabled} />
  </div>
</BaseLayout>
