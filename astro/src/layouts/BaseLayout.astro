---
/**
 * BaseLayout.astro — SEO foundation for every public page.
 *
 * Props:
 *   title         — <title> tag and OG title (required)
 *   description   — meta description and OG description (required)
 *   image         — OG image URL (absolute, default: /og-default.png)
 *   canonicalUrl  — override the canonical URL (default: current page URL)
 *   noindex       — set to true to block crawling (e.g. /gracias pages)
 *   schema        — JSON-LD schema.org object (optional, serialized to script tag)
 *   type          — OG type: 'website' | 'article' | 'product' (default: 'website')
 */

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  schema?: Record<string, any>;
  type?: 'website' | 'article' | 'product';
  /** Hide the floating cart drawer (e.g. checkout page already shows the cart) */
  hideCart?: boolean;
}

import CartDrawer from '../components/islands/CartDrawer';
import { resolveSiteOrigin } from '../lib/public-urls';
import '../styles/tailwind.css';
import '../styles/public-site.css';

const {
  title,
  description,
  image = '/og-default.png',
  canonicalUrl = Astro.url.href,
  noindex = false,
  schema,
  type = 'website',
  hideCart = false,
} = Astro.props;

const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';

const siteName = import.meta.env.PUBLIC_BRAND_NAME ?? 'Mi Empresa';
const brandFavicon = import.meta.env.PUBLIC_BRAND_ICON_URL ?? '/favicon.svg';
const faviconIsSvg = brandFavicon.endsWith('.svg');
const siteUrl = resolveSiteOrigin(Astro.site, Astro.url);
const pageTitle = `${title} — ${siteName}`;
const absImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- Evita flash de tema: lee localStorage antes del paint (misma clave que ThemeToggle). -->
    <script is:inline>
      (function () {
        try {
          var k = 'pragmata_astro_theme';
          var s = localStorage.getItem(k);
          if (s === 'dark') document.documentElement.classList.add('dark');
          else if (s === 'light') document.documentElement.classList.remove('dark');
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches)
            document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ── SEO Core ─────────────────────────────────────────────── -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      Astro.site && (
        <link
          rel="sitemap"
          type="application/xml"
          title="Sitemap"
          href={new URL('/sitemap.xml', Astro.site).href}
        />
      )
    }
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <!-- ── Open Graph ───────────────────────────────────────────── -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_MX" />

    <!-- ── Twitter Card ─────────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />

    <!-- ── Favicon (`astro/public/favicon.svg`; `/favicon.ico` → rewrite en `astro/vercel.json`) ─ -->
    <link
      rel="icon"
      href={brandFavicon}
      type={faviconIsSvg ? 'image/svg+xml' : undefined}
    />

    <!-- ── Typography (público) ─────────────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..900;1,14..32,400..900&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <!-- ── Schema.org JSON-LD ───────────────────────────────────── -->
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="public-site">
    <style is:global>
      :root {
        --font-public-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
        --font-public-mono: 'JetBrains Mono', ui-monospace, monospace;
      }
    </style>
    <slot />
    <!-- Cart drawer: visible on all public pages when ecommerce is enabled -->
    {ecommerceEnabled && !hideCart && <CartDrawer client:load />}
  </body>
</html>
