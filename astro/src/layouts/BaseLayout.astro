---
/**
 * BaseLayout.astro — SEO foundation for every public page.
 *
 * Props:
 *   title         — <title> tag and OG title (required)
 *   description   — meta description and OG description (required)
 *   image         — OG image URL (absolute, default: /og-default.png)
 *   canonicalUrl  — override the canonical URL (default: current page URL)
 *   noindex       — set to true to block crawling (e.g. /gracias pages)
 *   schema        — JSON-LD schema.org object (optional, serialized to script tag)
 *   type          — OG type: 'website' | 'article' | 'product' (default: 'website')
 */

export interface Props {
  title:          string;
  description:    string;
  image?:         string;
  canonicalUrl?:  string;
  noindex?:       boolean;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  schema?:        Record<string, any>;
  type?:          'website' | 'article' | 'product';
  /** Hide the floating cart drawer (e.g. checkout page already shows the cart) */
  hideCart?:      boolean;
}

import CartDrawer from '../components/islands/CartDrawer';

const {
  title,
  description,
  image         = '/og-default.png',
  canonicalUrl  = Astro.url.href,
  noindex       = false,
  schema,
  type          = 'website',
  hideCart      = false,
} = Astro.props;

const ecommerceEnabled = import.meta.env.PUBLIC_ENABLE_ECOMMERCE === 'true';

const siteName  = import.meta.env.PUBLIC_BRAND_NAME  ?? 'Mi Empresa';
const siteUrl   = import.meta.env.PUBLIC_SITE_URL    ?? 'https://tucliente.com';
const pageTitle = `${title} — ${siteName}`;
const absImage  = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ── SEO Core ─────────────────────────────────────────────── -->
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow" />}

  <!-- ── Open Graph ───────────────────────────────────────────── -->
  <meta property="og:type"        content={type} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={absImage} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:site_name"   content={siteName} />
  <meta property="og:locale"      content="es_MX" />

  <!-- ── Twitter Card ─────────────────────────────────────────── -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={absImage} />

  <!-- ── Favicon ──────────────────────────────────────────────── -->
  <link rel="icon"             href="/favicon.ico" sizes="any" />
  <link rel="icon"             href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest"         href="/site.webmanifest" />

  <!-- ── Performance hints ────────────────────────────────────── -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

  <!-- ── Schema.org JSON-LD ───────────────────────────────────── -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- ── Global styles ────────────────────────────────────────── -->
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    :root {
      --brand-primary: #1A2740;
      --brand-accent:  #1A7FF0;
      --brand-fg:      #0B1220;
      --brand-muted:   #5A6B85;
      --brand-bg:      #F7F8FB;
      --brand-surface: #FFFFFF;
      --brand-border:  #E3E8F2;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', sans-serif;
      font-size: 16px;
      line-height: 1.6;
      color: var(--brand-fg);
      background: var(--brand-bg);
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    img, video { max-width: 100%; height: auto; }
  </style>
</head>
<body>
  <slot />
  <!-- Cart drawer: visible on all public pages when ecommerce is enabled -->
  {ecommerceEnabled && !hideCart && (
    <CartDrawer client:load />
  )}
</body>
</html>
